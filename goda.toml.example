# goda.toml: the extensions to link into one plugin binary.
#
#   goda-build -manifest goda.toml -o goda-cmp
#
# Naming convention:
#   goda-cmp.vim            a Vim plugin built on goda (note the .vim)
#   goda-cmp-source-file    an extension repository (a Go module, no .vim)
#   goda-cmp-filter-*, goda-cmp-ui-*   same idea for filters and UIs
#
# Extensions are plain Go packages exporting New(). They run inside the
# plugin process and must be pure Go (the build sets CGO_ENABLED=0).

[goda]
# Where the SDK and transports come from. goda.vim is not published yet, so
# point at a local checkout (a relative path is resolved against this file).
# Once it is published, drop `replace` and pin a version instead:
#   version = "v0.1.0"
replace = "."

# In-tree examples shipped with goda.vim.
[[source]]
name = "around"
package = "github.com/Shougo/goda.vim/ext/source/around"

[[source]]
name = "vim"
package = "github.com/Shougo/goda.vim/ext/source/vim"

[[filter]]
name = "matcher_head"
package = "github.com/Shougo/goda.vim/ext/filter/matcher_head"

[[filter]]
name = "sorter_length"
package = "github.com/Shougo/goda.vim/ext/filter/sorter_length"

[[filter]]
name = "converter_truncate_abbr"
package = "github.com/Shougo/goda.vim/ext/filter/converter_truncate_abbr"

# An extension in its own repository (illustrative; this repository does not
# exist). The version is pinned and verified by the Go checksum database.
#
# [[source]]
# name = "file"
# package = "github.com/example/goda-cmp-source-file"
# version = "v0.1.0"
#
# While hacking on it locally:
#
# [[source]]
# name = "file"
# package = "github.com/example/goda-cmp-source-file"
# replace = "../goda-cmp-source-file"
